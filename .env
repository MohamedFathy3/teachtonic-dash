# Server Configuration
VITE_DEV_SERVER_HOST=::
VITE_DEV_SERVER_PORT=7000
VITE_PREVIEW_SERVER_HOST=::
VITE_PREVIEW_SERVER_PORT=7000

# API Configuration
VITE_API_TARGET=https://api.web-lec.com/
VITE_API_REWRITE_PATH=/api
VITE_API_HEADER_NAME=X-Requested-With
VITE_API_HEADER_VALUE=XMLHttpRequest

# Sanctum Configuration
VITE_SANCTUM_TARGET=https://api.web-lec.com/

# Allowed Hosts (comma separated)
VITE_ALLOWED_HOSTS=web-lec.com,localhost,127.0.0.1,::1,.web-lec.com

# Environment
NODE_ENV=development